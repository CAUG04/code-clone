def test_la_contrasena_nunca_viaja_en_las_respuestas(client, register):
    data = register(client, "carla@ejemplo.com", "miClaveSecreta1")
    texto = str(data)
    assert "miClaveSecreta1" not in texto
    assert "password" not in data["user"]
    assert "password_hash" not in data["user"]

    res = client.get("/api/auth/me", headers={"Authorization": f"Bearer {data['access_token']}"})
    assert "password_hash" not in res.json()


def test_la_contrasena_se_guarda_con_hash_y_sal(client, register):
    """Dos usuarios con la misma contraseña deben tener hashes distintos."""
    from app.database import SessionLocal
    from app.models import User

    register(client, "d@ejemplo.com", "mismaClave123")
    register(client, "e@ejemplo.com", "mismaClave123")

    db = SessionLocal()
    try:
        hashes = [u.password_hash for u in db.query(User).all()]
    finally:
        db.close()

    assert all("mismaClave123" not in h for h in hashes), "la contraseña quedó en texto plano"
    assert len(set(hashes)) == len(hashes), "sin sal: contraseñas iguales dan el mismo hash"



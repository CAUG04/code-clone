def test_texto_muy_largo_no_tumba_el_servidor(client{= FIX =}):
    plural = ENTITIES[0]
    cuerpo = dict(PAYLOADS[plural])
    campo_texto = next((k for k, v in cuerpo.items() if isinstance(v, str)), None)
    if campo_texto is None:
        pytest.skip("esta entidad no tiene campos de texto")
    cuerpo[campo_texto] = "A" * 100_000
    res = client.post(f"/api/{plural}", json=cuerpo{= AUTH =})
    assert res.status_code < 500

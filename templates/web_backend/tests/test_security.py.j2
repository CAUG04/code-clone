def test_inyeccion_sql_no_rompe_ni_borra_nada(client{= FIX =}):
    """SQLAlchemy usa consultas parametrizadas; esto lo verifica."""
    plural = ENTITIES[0]
    client.post(f"/api/{plural}", json=PAYLOADS[plural]{= AUTH =})

    ataques = [
        "'; DROP TABLE {= spec.entities[0].plural =}; --",
        "1 OR 1=1",
        "' OR '1'='1",
        "1; DELETE FROM users; --",
    ]
    for ataque in ataques:
        res = client.get(f"/api/{plural}/{ataque}"{= AUTH =})
        # 404 o 422 son respuestas sanas; 500 significaría que llegó a la base.
        assert res.status_code in (404, 422), f"'{ataque}' provocó {res.status_code}"

    # La tabla sigue viva con su registro.
    assert len(client.get(f"/api/{plural}"{= AUTH =}).json()) == 1


def test_texto_con_html_se_guarda_tal_cual_sin_ejecutarse(client{= FIX =}):
    """La API guarda el texto sin interpretarlo; el frontend lo escapa al mostrarlo."""
    plural = ENTITIES[0]
    cuerpo = dict(PAYLOADS[plural])
    campo_texto = next(
        (k for k, v in cuerpo.items() if isinstance(v, str) and "@" not in v and "http" not in v),
        None,
    )
    if campo_texto is None:
        pytest.skip("esta entidad no tiene campos de texto libre")

    payload = "<script>alert('xss')</script>"
    cuerpo[campo_texto] = payload
    res = client.post(f"/api/{plural}", json=cuerpo{= AUTH =})
    assert res.status_code == 201, res.text
    assert res.json()[campo_texto] == payload  # intacto, ni ejecutado ni mutilado



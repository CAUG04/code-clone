"""Pruebas de seguridad.

Cubren los fallos que de verdad se ven en producción: endpoints sin
proteger, datos de un usuario visibles para otro, tokens manipulados,
contraseñas que se filtran en las respuestas e inyección SQL.
"""
import pytest

from .conftest import ENTITIES, PAYLOADS
{% if spec.needs_auth %}


# ---------------------------------------------------------------------------
# Autenticación obligatoria
# ---------------------------------------------------------------------------

@pytest.mark.parametrize("plural", ENTITIES)
def test_sin_token_no_se_puede_hacer_nada(client, plural):
    """Ningún endpoint de datos debe responder sin autenticación."""
    casos = [
        ("get", f"/api/{plural}", {}),
        ("post", f"/api/{plural}", {"json": PAYLOADS[plural]}),
        ("get", f"/api/{plural}/1", {}),
        ("put", f"/api/{plural}/1", {"json": PAYLOADS[plural]}),
        ("delete", f"/api/{plural}/1", {}),
    ]
    for metodo, url, kwargs in casos:
        res = getattr(client, metodo)(url, **kwargs)
        assert res.status_code == 401, f"{metodo.upper()} {url} respondió {res.status_code} sin token"


@pytest.mark.parametrize(
    "token",
    [
        "",
        "basura",
        "Bearer",
        "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.firma-inventada",
        # Algoritmo "none": intento clásico de saltarse la firma.
        "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiIxIn0.",
    ],
)
def test_tokens_invalidos_son_rechazados(client, token):
    res = client.get("/api/auth/me", headers={"Authorization": f"Bearer {token}"})
    assert res.status_code == 401


def test_token_firmado_con_otra_clave_es_rechazado(client, auth_a):
    """Un token bien formado pero firmado con otra clave no debe servir."""
    import jwt

    falso = jwt.encode({"sub": "1"}, "clave-del-atacante", algorithm="HS256")
    res = client.get("/api/auth/me", headers={"Authorization": f"Bearer {falso}"})
    assert res.status_code == 401


def test_token_expirado_es_rechazado(client):
    from datetime import datetime, timedelta, timezone

    import jwt

    from app.auth import ALGORITHM, SECRET_KEY

    vencido = jwt.encode(
        {"sub": "1", "exp": datetime.now(timezone.utc) - timedelta(days=1)},
        SECRET_KEY,
        algorithm=ALGORITHM,
    )
    res = client.get("/api/auth/me", headers={"Authorization": f"Bearer {vencido}"})
    assert res.status_code == 401


# ---------------------------------------------------------------------------
# Aislamiento entre usuarios — la prueba más importante
# ---------------------------------------------------------------------------

@pytest.mark.parametrize("plural", ENTITIES)
def test_un_usuario_no_ve_los_datos_de_otro(client, auth_a, auth_b, plural):
    creado = client.post(f"/api/{plural}", json=PAYLOADS[plural], headers=auth_a).json()

    # B no lo ve en su lista.
    assert client.get(f"/api/{plural}", headers=auth_b).json() == []

    # Ni accediendo por id directo.
    assert client.get(f"/api/{plural}/{creado['id']}", headers=auth_b).status_code == 404


@pytest.mark.parametrize("plural", ENTITIES)
def test_un_usuario_no_puede_modificar_ni_borrar_lo_de_otro(client, auth_a, auth_b, plural):
    creado = client.post(f"/api/{plural}", json=PAYLOADS[plural], headers=auth_a).json()

    assert client.put(
        f"/api/{plural}/{creado['id']}", json=PAYLOADS[plural], headers=auth_b
    ).status_code == 404
    assert client.delete(f"/api/{plural}/{creado['id']}", headers=auth_b).status_code == 404

    # Y sigue intacto para su dueño.
    assert client.get(f"/api/{plural}/{creado['id']}", headers=auth_a).status_code == 200


def test_no_se_puede_suplantar_al_dueno_al_crear(client, auth_a, auth_b):
    """Mandar owner_id de otro usuario en el cuerpo no debe cambiar el dueño."""
    plural = ENTITIES[0]
    cuerpo = dict(PAYLOADS[plural])
    cuerpo["owner_id"] = 999  # campo que el esquema debe ignorar
    res = client.post(f"/api/{plural}", json=cuerpo, headers=auth_a)
    assert res.status_code == 201, res.text
    # Sigue siendo de A, y B no lo ve.
    assert client.get(f"/api/{plural}", headers=auth_b).json() == []
    assert len(client.get(f"/api/{plural}", headers=auth_a).json()) == 1



from datetime import datetime, timezone

from sqlalchemy import {= sa_imports | join(', ') =}

from .database import Base


def ahora() -> datetime:
    """Momento actual en UTC, sin zona horaria.

    No usamos datetime.utcnow(): está deprecado desde Python 3.12 y emite un
    DeprecationWarning en cada inserción. Las columnas son DateTime sin zona,
    así que devolvemos UTC "desnudo" para no cambiar lo que ya se guardaba.
    """
    return datetime.now(timezone.utc).replace(tzinfo=None)

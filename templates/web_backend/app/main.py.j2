import json
import logging
from contextlib import asynccontextmanager
from pathlib import Path

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from . import models, schemas
from .database import Base, SessionLocal, engine
{% if spec.needs_auth %}
from .auth import hash_password, router as auth_router
{% endif %}
{% for e in spec.entities %}
from .routers.{= e.snake =} import router as {= e.snake =}_router
{% endfor %}

log = logging.getLogger("uvicorn")
SEED_FILE = Path(__file__).parent / "seed.json"
{% if spec.needs_auth %}
DEMO_EMAIL = "demo@demo.com"
DEMO_PASSWORD = "demo1234"
{% endif %}

SEED_MODELS = {
{% for e in spec.entities %}
    "{= e.name =}": (models.{= e.name =}, schemas.{= e.name =}Create),
{% endfor %}
}


def seed_database() -> None:
    """Carga datos de ejemplo la primera vez que arranca la app."""
    if not SEED_FILE.exists():
        return
    db = SessionLocal()
    try:
{% if spec.needs_auth %}
        if db.query(models.User).first():
            return
        demo = models.User(
            email=DEMO_EMAIL, full_name="Usuario Demo", password_hash=hash_password(DEMO_PASSWORD)
        )
        db.add(demo)
        db.flush()
        extra = {"owner_id": demo.id}
{% else %}
        extra = {}
{% endif %}
        data = json.loads(SEED_FILE.read_text(encoding="utf-8"))
        for entity_name, rows in data.items():
            if entity_name not in SEED_MODELS:
                continue
            Model, Schema = SEED_MODELS[entity_name]
{% if not spec.needs_auth %}
            if db.query(Model).first():
                continue
{% endif %}
            for row in rows:
                try:
                    clean = Schema(**row).model_dump()
                except Exception as exc:  # datos de ejemplo inválidos: se ignoran
                    log.warning("Seed %s ignorado: %s", entity_name, exc)
                    continue
                db.add(Model(**clean, **extra))
        db.commit()
{% if spec.needs_auth %}
        log.info("Datos de ejemplo cargados. Usuario demo: %s / %s", DEMO_EMAIL, DEMO_PASSWORD)
{% else %}
        log.info("Datos de ejemplo cargados.")
{% endif %}
    finally:
        db.close()


@asynccontextmanager
async def lifespan(app: FastAPI):
    Base.metadata.create_all(bind=engine)
    seed_database()
    yield


app = FastAPI(
    title="{= spec.app_name =} API",
    description="{= spec.tagline =}",
    version="0.1.0",
    lifespan=lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # En producción, limita esto a tu dominio.
    allow_credentials=False,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/api/health", tags=["Sistema"])
def health():
    return {"status": "ok", "app": "{= spec.app_name =}"}


{% if spec.needs_auth %}
app.include_router(auth_router)
{% endif %}
{% for e in spec.entities %}
app.include_router({= e.snake =}_router)
{% endfor %}

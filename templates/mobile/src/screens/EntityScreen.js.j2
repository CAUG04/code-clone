import { useCallback, useEffect, useMemo, useState } from "react";
import {
  ActivityIndicator, Alert, FlatList, KeyboardAvoidingView, Modal, Platform, Pressable,
  RefreshControl, ScrollView, StyleSheet, Switch, Text, TextInput, View,
} from "react-native";
import { api } from "../api";
import { useTheme } from "../theme";

// ---------- conversión formulario <-> API ----------

function emptyForm(entity) {
  const v = {};
  entity.fields.forEach((f) => (v[f.name] = f.type === "boolean" ? false : ""));
  return v;
}

function toForm(entity, item) {
  const v = {};
  entity.fields.forEach((f) => {
    const raw = item[f.name];
    if (f.type === "boolean") v[f.name] = !!raw;
    else if (raw === null || raw === undefined) v[f.name] = "";
    else if (f.type === "datetime") v[f.name] = String(raw).slice(0, 16).replace("T", " ");
    else v[f.name] = String(raw);
  });
  return v;
}

function fromForm(entity, values) {
  const out = {};
  entity.fields.forEach((f) => {
    const raw = values[f.name];
    if (f.type === "boolean") out[f.name] = !!raw;
    else if (raw === "" || raw === undefined) out[f.name] = null;
    else if (f.type === "integer") out[f.name] = parseInt(raw, 10);
    else if (f.type === "float") out[f.name] = parseFloat(String(raw).replace(",", "."));
    else if (f.type === "datetime") out[f.name] = String(raw).trim().replace(" ", "T");
    else out[f.name] = raw;
  });
  return out;
}

function formatValue(field, value) {
  if (value === null || value === undefined || value === "") return "—";
  if (field.type === "boolean") return value ? "Sí" : "No";
  if (field.type === "datetime") return String(value).slice(0, 16).replace("T", " ");
  if (field.type === "float") return Number(value).toLocaleString(undefined, { maximumFractionDigits: 2 });
  return String(value);
}

const PLACEHOLDERS = { date: "AAAA-MM-DD", datetime: "AAAA-MM-DD HH:MM" };
const KEYBOARDS = { integer: "number-pad", float: "decimal-pad", email: "email-address", url: "url" };

// ---------- pantalla ----------

export default function EntityScreen({ entity }) {
  const t = useTheme();
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [editing, setEditing] = useState(null);
  const [formOpen, setFormOpen] = useState(false);
  const [values, setValues] = useState({});
  const [saving, setSaving] = useState(false);

  const load = useCallback(async () => {
    setError("");
    try {
      setItems(await api.list(entity.plural));
    } catch (e) {
      setError(e.message);
    }
  }, [entity.plural]);

  useEffect(() => {
    load().finally(() => setLoading(false));
  }, [load]);

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return items;
    return items.filter((it) => Object.values(it).some((v) => String(v ?? "").toLowerCase().includes(q)));
  }, [items, search]);

  function openNew() {
    setEditing(null);
    setValues(emptyForm(entity));
    setError("");
    setFormOpen(true);
  }

  function openEdit(item) {
    setEditing(item);
    setValues(toForm(entity, item));
    setError("");
    setFormOpen(true);
  }

  async function save() {
    const missing = entity.fields.filter(
      (f) => f.required && f.type !== "boolean" && String(values[f.name] ?? "").trim() === "",
    );
    if (missing.length) {
      setError(`Completa: ${missing.map((f) => f.label).join(", ")}`);
      return;
    }
    setSaving(true);
    setError("");
    try {
      const data = fromForm(entity, values);
      if (editing) {
        const updated = await api.update(entity.plural, editing.id, data);
        setItems((xs) => xs.map((x) => (x.id === updated.id ? updated : x)));
      } else {
        const created = await api.create(entity.plural, data);
        setItems((xs) => [created, ...xs]);
      }
      setFormOpen(false);
    } catch (e) {
      setError(e.message);
    } finally {
      setSaving(false);
    }
  }

  function confirmDelete(item) {
    const label = String(item[entity.displayField] ?? `#${item.id}`);
    Alert.alert("Eliminar", `¿Eliminar "${label}"?`, [
      { text: "Cancelar", style: "cancel" },
      {
        text: "Eliminar",
        style: "destructive",
        onPress: async () => {
          try {
            await api.remove(entity.plural, item.id);
            setItems((xs) => xs.filter((x) => x.id !== item.id));
            setFormOpen(false);
          } catch (e) {
            setError(e.message);
          }
        },
      },
    ]);
  }

  const secondary = entity.fields.filter((f) => f.name !== entity.displayField).slice(0, 3);
  const inputStyle = [styles.input, { borderColor: t.border, color: t.text, backgroundColor: t.bg }];

  return (
    <View style={styles.flex}>
      <View style={styles.header}>
        <View style={{ flex: 1 }}>
          <Text style={[styles.title, { color: t.text }]}>{entity.titlePlural}</Text>
          {!!entity.description && <Text style={{ color: t.muted }}>{entity.description}</Text>}
        </View>
      </View>

      <TextInput
        style={[inputStyle, styles.search]}
        placeholder="Buscar..."
        placeholderTextColor={t.muted}
        value={search}
        onChangeText={setSearch}
      />

      {!!error && !formOpen && <Text style={[styles.error, { color: t.danger }]}>{error}</Text>}

      {loading ? (
        <ActivityIndicator style={{ marginTop: 40 }} color={t.primary} />
      ) : (
        <FlatList
          data={filtered}
          keyExtractor={(it) => String(it.id)}
          contentContainerStyle={styles.list}
          refreshControl={
            <RefreshControl
              refreshing={refreshing}
              tintColor={t.primary}
              onRefresh={async () => {
                setRefreshing(true);
                await load();
                setRefreshing(false);
              }}
            />
          }
          ListEmptyComponent={
            <Text style={[styles.empty, { color: t.muted }]}>
              {items.length === 0 ? "Aún no hay registros. Toca + para crear el primero." : "Sin resultados."}
            </Text>
          }
          renderItem={({ item }) => (
            <Pressable
              onPress={() => openEdit(item)}
              onLongPress={() => confirmDelete(item)}
              style={({ pressed }) => [
                styles.row,
                { backgroundColor: t.surface, borderColor: t.border, opacity: pressed ? 0.7 : 1 },
              ]}
            >
              <Text style={[styles.rowTitle, { color: t.text }]} numberOfLines={1}>
                {String(item[entity.displayField] ?? `#${item.id}`)}
              </Text>
              {secondary.map((f) => (
                <Text key={f.name} style={{ color: t.muted, fontSize: 13 }} numberOfLines={1}>
                  {f.label}: {formatValue(f, item[f.name])}
                </Text>
              ))}
            </Pressable>
          )}
        />
      )}

      <Pressable style={[styles.fab, { backgroundColor: t.primary }]} onPress={openNew}>
        <Text style={styles.fabText}>+</Text>
      </Pressable>

      <Modal visible={formOpen} animationType="slide" presentationStyle="pageSheet" onRequestClose={() => setFormOpen(false)}>
        <KeyboardAvoidingView
          style={[styles.flex, { backgroundColor: t.surface }]}
          behavior={Platform.OS === "ios" ? "padding" : undefined}
        >
          <View style={[styles.modalHeader, { borderBottomColor: t.border }]}>
            <Pressable onPress={() => setFormOpen(false)} hitSlop={10}>
              <Text style={{ color: t.muted, fontSize: 16 }}>Cancelar</Text>
            </Pressable>
            <Text style={[styles.modalTitle, { color: t.text }]}>
              {editing ? `Editar ${entity.title}` : `Nuevo ${entity.title}`}
            </Text>
            <Pressable onPress={save} disabled={saving} hitSlop={10}>
              {saving ? <ActivityIndicator color={t.primary} /> : (
                <Text style={{ color: t.primary, fontSize: 16, fontWeight: "700" }}>Guardar</Text>
              )}
            </Pressable>
          </View>

          <ScrollView contentContainerStyle={styles.form} keyboardShouldPersistTaps="handled">
            {!!error && <Text style={[styles.error, { color: t.danger }]}>{error}</Text>}
            {entity.fields.map((f) =>
              f.type === "boolean" ? (
                <View key={f.name} style={styles.switchRow}>
                  <Text style={[styles.label, { color: t.text }]}>{f.label}</Text>
                  <Switch
                    value={!!values[f.name]}
                    onValueChange={(v) => setValues({ ...values, [f.name]: v })}
                    trackColor={{ true: t.primary }}
                  />
                </View>
              ) : (
                <View key={f.name} style={styles.field}>
                  <Text style={[styles.label, { color: t.text }]}>
                    {f.label}
                    {f.required ? <Text style={{ color: t.danger }}> *</Text> : null}
                  </Text>
                  <TextInput
                    style={[inputStyle, f.type === "text" && styles.multiline]}
                    value={String(values[f.name] ?? "")}
                    onChangeText={(v) => setValues({ ...values, [f.name]: v })}
                    placeholder={PLACEHOLDERS[f.type] || f.description}
                    placeholderTextColor={t.muted}
                    keyboardType={KEYBOARDS[f.type] || "default"}
                    autoCapitalize={["email", "url"].includes(f.type) ? "none" : "sentences"}
                    multiline={f.type === "text"}
                  />
                </View>
              ),
            )}
            {editing && (
              <Pressable style={[styles.deleteBtn, { borderColor: t.danger }]} onPress={() => confirmDelete(editing)}>
                <Text style={{ color: t.danger, fontWeight: "700" }}>Eliminar</Text>
              </Pressable>
            )}
          </ScrollView>
        </KeyboardAvoidingView>
      </Modal>
    </View>
  );
}

const styles = StyleSheet.create({
  flex: { flex: 1 },
  header: { flexDirection: "row", paddingHorizontal: 18, paddingTop: 18, paddingBottom: 10 },
  title: { fontSize: 26, fontWeight: "800" },
  search: { marginHorizontal: 18, marginBottom: 8 },
  input: { borderWidth: 1, borderRadius: 12, paddingHorizontal: 14, paddingVertical: 11, fontSize: 16 },
  multiline: { minHeight: 100, textAlignVertical: "top" },
  error: { marginHorizontal: 18, marginBottom: 8, fontSize: 14 },
  list: { padding: 18, paddingTop: 6, gap: 10, paddingBottom: 100 },
  row: { borderWidth: 1, borderRadius: 14, padding: 14, gap: 3 },
  rowTitle: { fontSize: 16, fontWeight: "700" },
  empty: { textAlign: "center", marginTop: 40, paddingHorizontal: 30 },
  fab: {
    position: "absolute", right: 20, bottom: 20, width: 58, height: 58, borderRadius: 29,
    alignItems: "center", justifyContent: "center", elevation: 4,
    shadowColor: "#000", shadowOpacity: 0.2, shadowRadius: 8, shadowOffset: { width: 0, height: 3 },
  },
  fabText: { color: "#fff", fontSize: 30, lineHeight: 32, fontWeight: "600" },
  modalHeader: {
    flexDirection: "row", alignItems: "center", justifyContent: "space-between",
    padding: 16, borderBottomWidth: StyleSheet.hairlineWidth,
  },
  modalTitle: { fontSize: 17, fontWeight: "700" },
  form: { padding: 18, gap: 16 },
  field: { gap: 6 },
  label: { fontSize: 14, fontWeight: "600" },
  switchRow: { flexDirection: "row", alignItems: "center", justifyContent: "space-between" },
  deleteBtn: { borderWidth: 1, borderRadius: 12, paddingVertical: 12, alignItems: "center", marginTop: 10 },
});

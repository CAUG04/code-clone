:root {
  --primary: {= spec.color_primary =};
  --primary-soft: color-mix(in srgb, var(--primary) 12%, transparent);
  --bg: #f6f7fb;
  --surface: #ffffff;
  --text: #16181d;
  --muted: #6b7280;
  --border: #e5e7eb;
  --danger: #dc2626;
  --radius: 14px;
  --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 4px 16px rgba(16, 24, 40, 0.06);
  font-family: "Inter", system-ui, -apple-system, sans-serif;
  color: var(--text);
  background: var(--bg);
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0f1115;
    --surface: #181b21;
    --text: #eef0f3;
    --muted: #9aa1ad;
    --border: #2a2f38;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
}

* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); }
h1, h2 { margin: 0 0 6px; letter-spacing: -0.02em; }
h1 { font-size: 1.8rem; }
h2 { font-size: 1.2rem; }
a { color: inherit; text-decoration: none; }
.muted { color: var(--muted); margin: 0; }
.small { font-size: 0.82rem; }

/* Layout */
.layout { display: flex; min-height: 100vh; }
.sidebar {
  width: 240px; flex-shrink: 0; background: var(--surface); border-right: 1px solid var(--border);
  padding: 22px 14px; display: flex; flex-direction: column; gap: 18px;
  position: sticky; top: 0; height: 100vh;
}
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; padding: 0 8px; }
.brand-dot { width: 14px; height: 14px; border-radius: 5px; background: var(--primary); }
.sidebar nav { display: flex; flex-direction: column; gap: 2px; flex: 1; }
.sidebar nav a { padding: 9px 12px; border-radius: 10px; color: var(--muted); font-weight: 500; }
.sidebar nav a:hover { background: var(--primary-soft); color: var(--text); }
.sidebar nav a.active { background: var(--primary-soft); color: var(--primary); font-weight: 600; }
.content { flex: 1; padding: 32px clamp(16px, 4vw, 48px); max-width: 1200px; min-width: 0; }
.menu-btn { display: none; }

.page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
.hero h1 { font-size: 2.2rem; }

/* Cards */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; margin-bottom: 18px; }
.stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-bottom: 18px; }
.stat { display: flex; flex-direction: column; gap: 4px; margin: 0; transition: transform 0.15s, border-color 0.15s; }
.stat:hover { transform: translateY(-2px); border-color: var(--primary); }
.stat-value { font-size: 2rem; font-weight: 700; color: var(--primary); }
.stat-label { font-weight: 600; }
.features { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 8px; }

/* Buttons */
.btn { border: 1px solid transparent; border-radius: 10px; padding: 9px 16px; font: inherit; font-weight: 600; cursor: pointer; transition: filter 0.15s, background 0.15s; }
.btn:disabled { opacity: 0.6; cursor: default; }
.btn.primary { background: var(--primary); color: #fff; }
.btn.primary:hover { filter: brightness(1.08); }
.btn.ghost { background: transparent; border-color: var(--border); color: var(--text); }
.btn.ghost:hover { background: var(--primary-soft); }
.btn.danger { background: transparent; color: var(--danger); }
.btn.danger:hover { background: color-mix(in srgb, var(--danger) 10%, transparent); }
.btn.link { background: none; color: var(--primary); padding: 4px; }
.logout { width: 100%; }

/* Forms */
label { display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.92rem; margin-bottom: 14px; }
label.check { flex-direction: row; align-items: center; gap: 10px; }
input, textarea { font: inherit; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--text); }
input:focus, textarea:focus { outline: 2px solid var(--primary-soft); border-color: var(--primary); }
input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--primary); }
.req { color: var(--danger); }
.search { width: 100%; margin-bottom: 14px; }
.error { background: color-mix(in srgb, var(--danger) 10%, transparent); color: var(--danger); border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; font-size: 0.92rem; }
.hint { color: var(--muted); font-size: 0.8rem; text-align: center; margin: 4px 0 0; }

/* Table */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); padding: 10px; border-bottom: 1px solid var(--border); }
td { padding: 12px 10px; border-bottom: 1px solid var(--border); }
tr:last-child td { border-bottom: none; }
td.actions { text-align: right; white-space: nowrap; }
.empty { text-align: center; padding: 30px 0; color: var(--muted); }

/* Modal */
.modal-backdrop { position: fixed; inset: 0; background: rgba(10, 12, 16, 0.45); display: grid; place-items: center; padding: 16px; z-index: 20; }
.modal { width: min(520px, 100%); max-height: 90vh; overflow-y: auto; margin: 0; }
.modal h2 { margin-bottom: 16px; }
.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 6px; }

/* Auth */
.auth-page { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
.auth-hero { background: var(--primary); color: #fff; padding: 48px; display: flex; flex-direction: column; justify-content: center; }
.auth-hero h1 { font-size: 2.6rem; }
.auth-hero p { font-size: 1.15rem; opacity: 0.9; }
.auth-card { align-self: center; justify-self: center; width: min(400px, calc(100% - 32px)); display: flex; flex-direction: column; }
.auth-card h2 { margin-bottom: 18px; }

/* Móvil */
@media (max-width: 800px) {
  .auth-page { grid-template-columns: 1fr; }
  .auth-hero { padding: 32px 20px; }
  .sidebar { position: fixed; left: 0; z-index: 30; transform: translateX(-100%); transition: transform 0.2s; }
  .sidebar.open { transform: none; box-shadow: var(--shadow); }
  .menu-btn { display: inline-block; font-size: 1.4rem; background: none; border: none; color: var(--text); margin-bottom: 10px; cursor: pointer; }
  .content { padding: 16px; }
}
